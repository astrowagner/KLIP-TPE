__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
runs/
tutorials/runs/
_sync/
*.log
.DS_Store

# Run outputs, not source.  paper_runs/ is 3.1 GB of FITS, panels and checkpoints on the
# machine that produced it; only the four drivers belong in the repo.  Anything added there
# later is ignored by default, which is the safe direction for a directory that fills up
# with hundreds of megabytes every time a stage runs.
paper_runs/*
!paper_runs/*.py
!paper_runs/*.sh
!paper_runs/*.md

# The instrument drivers default --out to the working directory, so a run started from the
# repo root leaves its products here (two F1140C runs: 18 MB, and they grow with --pdf-every
# and --movie).  Same policy as paper_runs/ above: outputs, not source.  Anchored to the root
# so nothing nested can match by accident.
/miri_*/
/M_*/

# archives of run outputs
*.tgz
*.tar.gz
*.zip

# search products that can land anywhere
heartbeat.json
checkpoint.json
results.jsonl
final_results.json
